---
import dayjs from "dayjs";

export interface Props {
  datetime: string | Date;
  size?: "sm" | "lg";
  class?: string;
}

const { datetime, size = "sm", class: className } = Astro.props;

const myDatetime = dayjs(datetime);
const date = myDatetime.format("MMMM D, YYYY");
const time = myDatetime.format("hh:mm A");
---

<div class:list={["flex items-center space-x-2 opacity-80", className]}>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    class:list={[
      "fill-skin-base inline-block h-6 w-6",
      { "scale-90": size === "sm", "scale-100": size === "lg" },
    ]}
    aria-hidden="true"
  >
    <path
      d="M7 11h2v2H7zm0 4h2v2H7zm4-4h2v2h-2zm0 4h2v2h-2zm4-4h2v2h-2zm0 4h2v2h-2z"
    ></path>
    <path
      d="M5 22h14c1.103 0 2-.897 2-2V6c0-1.103-.897-2-2-2h-2V2h-2v2H9V2H7v2H5c-1.103 0-2 .897-2 2v14c0 1.103.897 2 2 2zM19 8l.001 12H5V8h14z"
    ></path>
  </svg>
  <span class="sr-only">Posted on:</span>
  <span
    class:list={[
      "italic",
      { "text-sm": size === "sm", "text-base": size === "lg" },
    ]}
  >
    {date}
    <span aria-hidden="true"> | </span>
    <span class="sr-only">&nbsp;at&nbsp;</span>
    {time}
  </span>
</div>
