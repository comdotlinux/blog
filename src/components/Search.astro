---

---

<div id="search-container">
  <label class="relative block">
    <span class="absolute inset-y-0 left-0 flex items-center pl-2 opacity-75">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
        class="fill-skin-base h-6 w-6"
      >
        <path
          d="M19.023 16.977a35.13 35.13 0 0 1-1.367-1.384c-.372-.378-.596-.653-.596-.653l-2.8-1.337A6.962 6.962 0 0 0 16 9c0-3.859-3.14-7-7-7S2 5.141 2 9s3.14 7 7 7c1.763 0 3.37-.66 4.603-1.739l1.337 2.8s.275.224.653.596c.387.363.896.854 1.384 1.367l1.358 1.392.604.646 2.121-2.121-.646-.604c-.379-.372-.885-.866-1.391-1.36zM9 14c-2.757 0-5-2.243-5-5s2.243-5 5-5 5 2.243 5 5-2.243 5-5 5z"
        ></path>
      </svg>
    </span>
    <input
      id="search-input"
      class="border-skin-fill border-opacity-40 bg-skin-fill placeholder:text-opacity-75 focus:border-skin-accent block w-full rounded border py-3 pr-3 pl-10 placeholder:italic focus:outline-none"
      placeholder="Search for anything..."
      type="text"
      name="search"
      autocomplete="off"
    />
  </label>

  <div id="search-status" class="mt-8 hidden"></div>
  <div id="search-results" class="mt-4"></div>
</div>

<script is:inline>
  async function initPagefind() {
    const searchInput = document.getElementById("search-input");
    const searchResults = document.getElementById("search-results");
    const searchStatus = document.getElementById("search-status");

    if (!searchInput) return;

    let pagefind;
    try {
      pagefind = await import("/pagefind/pagefind.js");
      await pagefind.init();
    } catch (e) {
      console.warn("Pagefind not available yet - run build first");
      searchStatus.classList.remove("hidden");
      searchStatus.textContent =
        "Search index not available. Please build the site first.";
      return;
    }

    // Get initial query from URL
    const searchUrl = new URLSearchParams(window.location.search);
    const searchStr = searchUrl.get("q");
    if (searchStr) {
      searchInput.value = searchStr;
      await performSearch(searchStr);
    }

    // Focus input and set cursor position
    searchInput.focus();
    if (searchStr) {
      searchInput.selectionStart = searchInput.selectionEnd = searchStr.length;
    }

    // Handle input changes
    let debounceTimer;
    searchInput.addEventListener("input", e => {
      const value = e.target.value;
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => performSearch(value), 150);
    });

    async function performSearch(query) {
      // Update URL
      if (query.length > 0) {
        const searchParams = new URLSearchParams(window.location.search);
        searchParams.set("q", query);
        const newPath =
          window.location.pathname + "?" + searchParams.toString();
        history.pushState(null, "", newPath);
      } else {
        history.pushState(null, "", window.location.pathname);
      }

      if (query.length < 2) {
        searchResults.innerHTML = "";
        searchStatus.classList.add("hidden");
        return;
      }

      // Perform search
      const search = await pagefind.search(query);
      const results = await Promise.all(
        search.results.slice(0, 10).map(r => r.data())
      );

      // Show status
      searchStatus.classList.remove("hidden");
      searchStatus.textContent = `Found ${search.results.length} ${search.results.length === 1 ? "result" : "results"} for '${query}'`;

      // Render results
      if (results.length === 0) {
        searchResults.innerHTML = "";
        return;
      }

      searchResults.innerHTML = `
        <ul>
          ${results
            .map(
              result => `
            <li class="my-6">
              <a href="${result.url}" class="inline-block text-lg font-medium text-skin-accent decoration-dashed underline-offset-4 focus-visible:no-underline focus-visible:underline-offset-0">
                <h2 class="text-lg font-medium decoration-dashed hover:underline">${result.meta.title || "Untitled"}</h2>
              </a>
              <p>${result.excerpt || ""}</p>
            </li>
          `
            )
            .join("")}
        </ul>
      `;
    }
  }

  // Initialize on page load
  initPagefind();
</script>
